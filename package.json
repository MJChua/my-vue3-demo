{
  "name": "my-vue3-demo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite --open --port 9911",
    "serve": "pnpm dev",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "lint": "eslint . --ext .js,.vue --fix",
    "lint:check": "eslint . --ext .js,.vue",
    "lint:workspace": "pnpm -r --if-present lint",
    "format": "prettier --write .",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e:install": "playwright install chromium",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:headed": "playwright test --project=chromium --headed",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:ci": "pnpm lint:check && pnpm test:unit && pnpm test:e2e",
    "pre:pr:quick": "pnpm test:ci",
    "pre:pr": "pnpm test:ci && pnpm build"
  },
  "dependencies": {
    "@my-vue3/core": "workspace:*",
    "@my-vue3/http": "workspace:*",
    "axios": "^1.7.7",
    "core-js": "^3.8.3",
    "pinia": "^2.2.2",
    "vant": "^3.4.4",
    "vue": "^3.2.13",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.0.3",
    "vuex": "^4.0.0",
    "vuex-persistedstate": "^4.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.12.16",
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-standard": "^6.1.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^7.32.0",
    "eslint-plugin-import": "^2.25.3",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^5.1.0",
    "eslint-plugin-vue": "^7.20.0",
    "http-server": "^14.1.1",
    "jsdom": "^26.1.0",
    "msw": "^2.11.5",
    "prettier": "^3.6.2",
    "stylus": "^0.55.0",
    "stylus-loader": "^3.0.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
